# Environments and caches
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Data, weights, and experiment outputs stay outside git
data/
weights/
outputs/
checkpoints/
*.pth
*.pt
*.ckpt
*.ply
*.mp4

# Pinned upstream checkouts are local. The SHA list is third_party/PINS.md.
third_party/*
!third_party/PINS.md
!third_party/.gitkeep
